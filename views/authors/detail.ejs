<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= author.name %>
    </title>
</head>

<body>

    <h1>
        <%= author.name %>
    </h1>

    <p>
        <strong>ID:</strong>
        <%= author.author_id %>
    </p>

    <p>
        <a
            href="/library/admin/authors/<%= author.author_id %>/edit"
        >
            Editar autor
        </a>
    </p>

    <p>
        <a href="/library/admin/authors">
            Regresar al listado
        </a>
    </p>

</body>
</html>