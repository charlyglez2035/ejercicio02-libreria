<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Administrar autores</title>
</head>

<body>

    <h1>Administración de autores</h1>

    <% if (message) { %>
        <p>
            <%= message %>
        </p>
    <% } %>

    <p>
        <a href="/library/admin/authors/new">
            Crear nuevo autor
        </a>
    </p>

    <p>
        <a href="/library/admin">
            Regresar al panel
        </a>
    </p>

    <table
        border="1"
        cellpadding="6"
    >

        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>

            <% for (const author of authors) { %>

                <tr>

                    <td>
                        <%= author.author_id %>
                    </td>

                    <td>
                        <%= author.name %>
                    </td>

                    <td>

                        <a
                            href="/library/admin/authors/<%= author.author_id %>"
                        >
                            Ver
                        </a>

                        |

                        <a
                            href="/library/admin/authors/<%= author.author_id %>/edit"
                        >
                            Editar
                        </a>

                        |

                        <form
                            method="POST"
                            action="/library/admin/authors/<%= author.author_id %>/delete"
                            style="display:inline"
                            onsubmit="return confirm('¿Eliminar este autor?');"
                        >

                            <button type="submit">
                                Eliminar
                            </button>

                        </form>

                    </td>

                </tr>

            <% } %>

        </tbody>

    </table>

</body>
</html>