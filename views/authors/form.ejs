<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %></title>
</head>

<body>

    <h1><%= title %></h1>

    <% if (error) { %>

        <p>
            <strong>Error:</strong>
            <%= error %>
        </p>

    <% } %>

    <form
        method="POST"
        action="<%= action %>"
    >

        <div>

            <label for="name">
                Nombre del autor
            </label>

            <input
                type="text"
                id="name"
                name="name"
                maxlength="160"
                value="<%= author ? author.name : '' %>"
                required
            >

        </div>

        <br>

        <button type="submit">
            Guardar
        </button>

    </form>

    <p>
        <a href="/library/admin/authors">
            Cancelar
        </a>
    </p>

</body>
</html>